# Zig Task Manager Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ===== DATABASE (SurrealDB) =====
# Production: provision a database-level EDITOR, migrate separately, then set
# SURREAL_AUTH_LEVEL=database and DB_AUTO_MIGRATE=0 for the serving process.
# DB_MIGRATE_ONLY=1 applies migrations and exits without opening a listener.
SURREAL_URL=http://127.0.0.1:8000
SURREAL_NS=taskapp
SURREAL_DB=main
SURREAL_USER=root
SURREAL_PASS=

# ===== EMAIL (SMTP) =====
# Required 32-byte key, hex encoded. Provision with scripts/provision_mail_key.mjs.
# Preserve alongside private config backups; never store it in the DB.
MAIL_OUTBOX_KEY=
MAIL_WORKER_ENABLED=1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-a-real-smtp-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Task Manager
FROM_EMAIL=noreply@example.com
FROM_NAME=Task Manager

# Send a reminder email before a task falls due. Disabled by default so a
# fresh install cannot mail a burst of reminders for data it inherited.
TASK_REMINDERS_ENABLED=0
# Operator/test mode only: one eligible batch then exit, no HTTP server.
# Never set this to 1 on the serving service.
REMINDERS_PROCESS_ONCE=0
# How far ahead of the deadline the reminder goes out, in minutes. Reminders
# only reach addresses that have been verified.
TASK_REMINDER_LEAD_MINUTES=60

# Request threads. Defaults to the CPU count, capped at 16. Each concurrent
# password hash allocates the Argon2 memory cost (64 MB), so this is bounded
# by memory rather than by cores.
# SERVER_THREADS=10

# Logical task quotas, enforced by the application in fenced transactions.
# Existing overages are preserved; only growth is refused. Trash still counts.
# UTF-8 bytes of titles + notes + tags; not physical DB/index/backup disk usage.
WORKSPACE_TASK_LIMIT=10000
WORKSPACE_TEXT_BYTES_LIMIT=52428800
OWNED_WORKSPACE_LIMIT=25

# ===== APPLICATION =====
# Server configuration
PORT=9000
INTERFACE=127.0.0.1
# Use 0.0.0.0 for Docker (to accept external connections)

# Public base URL of the app (used in password-reset email links).
# Must match the origin users hit in their browser.
APP_BASE_URL=http://127.0.0.1:9000

# HSTS max-age in seconds. Enable ONLY in production behind HTTPS.
# Recommended: 31536000 (1 year). Leave unset for http:// dev.
# HSTS_MAX_AGE=31536000

# Exact browser origin; wildcards are not accepted. Local HTTP also needs
# COOKIE_INSECURE=1. Use HTTPS and secure cookies for a public installation.
CORS_ORIGIN=http://127.0.0.1:9000

# Trusted proxy IPs (comma-separated). Only these peers may set X-Real-IP /
# X-Forwarded-For to override the rate-limit client IP. Leave empty if you
# expose the server directly (not recommended).
TRUST_PROXY=

# Legacy Secret — ONLY needed if you have old FNV-1a password hashes in the DB
# from a pre-Argon2 install. Leave unset for new deployments.
# If you do need it, generate a unique value: `openssl rand -hex 32`
# LEGACY_SECRET=
